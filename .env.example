# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Runtime
RUNTIME_MAX_SHADER_BYTES=65536
RUNTIME_MAX_BUFFER_ELEMENTS=16777216
RUNTIME_MAX_DISPATCH_X=65535
RUNTIME_MAX_DISPATCH_Y=65535
RUNTIME_MAX_DISPATCH_Z=65535

# Worker
SERVER_URL=http://127.0.0.1:8080
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_POLL_INTERVAL_SECONDS=2